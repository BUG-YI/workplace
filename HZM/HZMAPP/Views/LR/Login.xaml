<Page x:Class="HZMAPP.Views.LR.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HZMAPP.Views.LR"
      xmlns:vm="clr-namespace:HZMAPP.ViewModels"
      mc:Ignorable="d">
    
    <Page.DataContext>
        <vm:LoginVM/>
    </Page.DataContext>
    
    <Grid ShowGridLines="True">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Login" 
                   HorizontalAlignment="Center"
                   FontSize="37"/>
        <TextBox Grid.Row="1" Width="200" Height="30" Text="{Binding Username, UpdateSourceTrigger=LostFocus}" ></TextBox>
        <PasswordBox Grid.Row="2" Width="200" Height="30" PasswordChanged="PasswordBox_OnPasswordChanged"></PasswordBox>
        <Button Grid.Row="3" Width="50" Content="login" Command="{Binding LoginCommand}"></Button>
        
    </Grid>
</Page>
