<Window x:Class="HZMAPP.Views.AppDetail.AppDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HZMAPP.Views.AppDetail"
        xmlns:vm="clr-namespace:HZMAPP.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="AppDetailWindow" MinHeight="450" MinWidth="650"   MaxWidth="650"><!--MaxHeight="550"-->
    
    <Window.DataContext>
        <vm:AppDetailVM></vm:AppDetailVM>
    </Window.DataContext>
    
    <Border
        CornerRadius="8"
        Background="White"
        BorderBrush="Black"
        BorderThickness="1">
        <Grid
            Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Border
                BorderBrush="#a1a1a1"
                BorderThickness="0,0,0,2">
                <Border.Effect>
                    <DropShadowEffect
                        Color="#c9c9c9"
                        Opacity="0.3"
                        BlurRadius="20"
                        ShadowDepth="2"
                        Direction="6"></DropShadowEffect>
                </Border.Effect>
                <Grid ShowGridLines="False"
                      Background="Transparent"
                      Cursor="ScrollAll"
                      MouseLeftButtonDown="WindowMove"
                      Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="21"
                        Text="应用详情"></TextBlock>
                    <Grid
                        HorizontalAlignment="Right"
                        Grid.Column="3">
                        <Border
                            MouseLeftButtonDown="CloseThisWindow"
                            Padding="5"
                            Width="40"
                            BorderBrush="#939393"
                            BorderThickness="1 ,0,0,0"
                            CornerRadius="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                    <Setter Property="Background" Value="Transparent"></Setter>
                                    
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#c9c9c9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image
                                Width="40"
                                Source="/Assets/Image/close.png">
                            </Image>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            
            <ScrollViewer
                Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            
                            <Border
                                HorizontalAlignment="Right"
                                Margin="20,10,20,0"
                                CornerRadius="8"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Width="70"
                                Height="70">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Image/hzm_white.png"></ImageBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Text="AppName"
                                FontSize="30"
                                FontWeight="Bold"
                                VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        Direction="0"
                                        BlurRadius="15"
                                        Opacity="0.5"
                                        ShadowDepth="5"></DropShadowEffect>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button
                                Foreground="AntiqueWhite"
                                Grid.Column="3"
                                Content="下载">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            CornerRadius="6"
                                            BorderBrush="Black"
                                            BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#7307f7" Offset="0"></GradientStop>
                                                                <GradientStop Color="#9616e6" Offset="0.2"></GradientStop>
                                                                <GradientStop Color="#b925d5" Offset="0.4"></GradientStop>
                                                                <GradientStop Color="#cb2ccc" Offset="0.6"></GradientStop>
                                                                <GradientStop Color="#ee3bbb" Offset="0.8"></GradientStop>
                                                                <GradientStop Color="#ff42b3" Offset="1"></GradientStop>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#8A28FF" Offset="0"/>
                                                                        <GradientStop Color="#A93AFF" Offset="0.2"/>
                                                                        <GradientStop Color="#CC42F0" Offset="0.4"/>
                                                                        <GradientStop Color="#E050E0" Offset="0.6"/>
                                                                        <GradientStop Color="#FF5ACC" Offset="0.8"/>
                                                                        <GradientStop Color="#FF66C6" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#939393"></Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    Color="#939393"
                                                    BlurRadius="20"
                                                    Opacity="0.5"></DropShadowEffect>
                                            </Border.Effect>
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"></ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                    
                    <Border
                        Margin="10,20,10,10"
                        Height="300"
                        Background="Azure"
                        Grid.Row="1">
                        <Grid
                            ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"></ColumnDefinition>
                                <ColumnDefinition Width=".5*"></ColumnDefinition>
                                <ColumnDefinition Width="100"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            
                            <Grid
                                Grid.Column="1" ShowGridLines="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition Height="90"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border
                                    Width="400"
                                    CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PreImage.ImageAddr,Mode=OneWay}"></ImageBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ScrollViewer
                                    PreviewMouseWheel="UIElement_OnPreviewMouseWheel"
                                    Padding="4,2"
                                    BorderBrush="Black"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Visible"
                                    BorderThickness="1"
                                    Grid.Row="1">
                                    <ItemsControl
                                        ItemsSource="{Binding ApplicationsDetail}"
                                        HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" ></StackPanel>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    CornerRadius="4"
                                                    BorderBrush="red"
                                                    BorderThickness="1"
                                                    Margin="4,0"
                                                    Height="69"
                                                    PreviewMouseLeftButtonDown="PreviewPicture"
                                                    Width="122">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ImageAddr}"></ImageBrush>
                                                    </Border.Background>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid
                        Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Border
                            Margin="0,20,0,0"
                            Grid.Column="1">
                            <Grid
                                >
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                
                                <Border>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Border
                                            Background="White"
                                            CornerRadius="8"
                                            Padding="10,8">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="15"
                                                    Opacity=".5"
                                                    Direction="2"
                                                    ShadowDepth="0"></DropShadowEffect>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Border
                                                    Padding="0,0,0,2"
                                                    BorderBrush="Black"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Text="说明"></TextBlock>
                                                </Border>
                                                <StackPanel
                                                    MinHeight="80"
                                                    Margin="0,8,0,8"
                                                    Grid.Row="1">
                                                    <TextBlock
                                                        FontSize="14"
                                                        Text="12吗"></TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Margin="0,20,0,0"
                                            Background="White"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Grid.Row="1">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="15"
                                                    Opacity=".5"
                                                    Direction="2"
                                                    ShadowDepth="0"></DropShadowEffect>
                                            </Border.Effect>
                                            
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Border
                                                    Padding="0,0,0,2"
                                                    BorderBrush="Black"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Text="评分"></TextBlock>
                                                </Border>
                                                <Grid
                                                    ShowGridLines="True"
                                                    Grid.Row="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition></RowDefinition>
                                                        <RowDefinition></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width=".7*"></ColumnDefinition>
                                                        <ColumnDefinition></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border
                                                        HorizontalAlignment="Right"
                                                        CornerRadius="8"
                                                        Margin="4,12,10,4"
                                                        Height="120"
                                                        Width="120"
                                                        Background="White">
                                                        <Border.Effect>
                                                            <DropShadowEffect
                                                                BlurRadius="20"
                                                                Direction="0"
                                                                ShadowDepth="0"
                                                                Opacity=".3"></DropShadowEffect>
                                                        </Border.Effect>
                                                        <StackPanel
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                FontSize="65"
                                                                FontWeight="Bold"
                                                                Text="4.9">
                                                                <TextBlock.Foreground>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#1fe623" Offset="0.2"></GradientStop>
                                                                        <GradientStop Color="#d900fc" Offset="0.4"></GradientStop>
                                                                        <GradientStop Color="#b200fc" Offset="0.6"></GradientStop>
                                                                        <GradientStop Color="#6600fe" Offset=".8"></GradientStop>
                                                                        <GradientStop Color="#c32a35" Offset="1"></GradientStop>
                                                                    </LinearGradientBrush>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                Text="共...条评论"></TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border
                                                        Margin="10,30,10,0"
                                                        Grid.Row="0"
                                                        Grid.Column="1">
                                                        <ItemsControl ItemsSource="{Binding Stars.Star}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                                <ColumnDefinition Width=".7*"></ColumnDefinition>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Key}"></TextBlock>
                                                                            <Border
                                                                                HorizontalAlignment="Left"
                                                                                Width="15"
                                                                                Grid.Column="1">
                                                                                <!--#e1ff00-->
                                                                                <Image
                                                                                    Source="/Assets/Image/star (2).png"></Image>
                                                                            </Border>
                                                                            <Border
                                                                                HorizontalAlignment="Left"
                                                                                Width="180"
                                                                                Margin="1,3"
                                                                                CornerRadius="6"
                                                                                Background="#e3e3e3"
                                                                                Grid.Column="2">
                                                                                <Border
                                                                                    HorizontalAlignment="Left"
                                                                                    Width="{Binding Value}"
                                                                                    CornerRadius="6"
                                                                                    Background="#ffea00">
                                                                                </Border>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2">
                                                        <Grid>
                                                            <Border
                                                                ToolTip="80"
                                                                Margin="5,15,0,0"
                                                                Padding="5,10"
                                                                BorderThickness="0,0,0,1"
                                                                BorderBrush="#9a9a9a">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                        <ColumnDefinition></ColumnDefinition>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition></RowDefinition>
                                                                        <RowDefinition></RowDefinition>
                                                                    </Grid.RowDefinitions>
                                                                    
                                                                    <Border
                                                                        Margin="12,0"
                                                                        CornerRadius="27"
                                                                        Width="55"
                                                                        Height="55"
                                                                        BorderBrush="red"
                                                                        BorderThickness="1">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="/Assets/Image/hzm_white.png"></ImageBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Border
                                                                        Grid.Row="0"
                                                                        Grid.Column="1">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition></RowDefinition>
                                                                                <RowDefinition></RowDefinition>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                                <ColumnDefinition></ColumnDefinition>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                TextTrimming="CharacterEllipsis"
                                                                                VerticalAlignment="Center"
                                                                                FontWeight="SemiBold"
                                                                                MaxWidth="100"
                                                                                FontSize="15"
                                                                                Text="use123"></TextBlock>
                                                                            <Border
                                                                                Margin="5,2,5,0"
                                                                                VerticalAlignment="Center"
                                                                                Width="10"
                                                                                Height="10"
                                                                                Grid.Row="0"
                                                                                Grid.Column="1">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="/Assets/Image/rightThree.png"></ImageBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <TextBlock
                                                                                Text="123"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Left"
                                                                                FontWeight="SemiBold"
                                                                                MaxWidth="100"
                                                                                FontSize="15"
                                                                                Grid.Row="0"
                                                                                Grid.Column="2"></TextBlock>
                                                                            <Grid
                                                                                Grid.Column="0"
                                                                                Grid.ColumnSpan="3"
                                                                                Grid.Row="1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition></ColumnDefinition>
                                                                                    <ColumnDefinition Width=".3*"></ColumnDefinition>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock
                                                                                    Padding="10,0"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="123"></TextBlock>
                                                                                <Border
                                                                                    Grid.Column="1">
                                                                                    <StackPanel 
                                                                                        Orientation="Horizontal"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center">
                                                                                        <Image Width="20" Source="/Assets/Image/down1.png"></Image>
                                                                                        <TextBlock 
                                                                                            FontSize="13"
                                                                                            Text="more">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="#9a9a9a"></Setter>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                            
                                        </Border>
                                        <Border
                                            Grid.Row="2">
                                            <TextBlock Text="其他"></TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
