<Page x:Class="HZMAPP.Views.AppStore.AppStorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HZMAPP.Views.AppStore"
      xmlns:vm="clr-namespace:HZMAPP.ViewModels"
      xmlns:model="clr-namespace:HZMAPP.Models"
      mc:Ignorable="d"
      Title="MainPage" MinHeight="450" MinWidth="450">
    
    <Page.DataContext>
        <vm:AppstorePageVM></vm:AppstorePageVM>
    </Page.DataContext>
    
    <ScrollViewer
        Padding="10">
        <Grid>
            <!--<Grid
                x:Name="OverlayPanel"
                Visibility="Visible"
                Panel.ZIndex="999"
                Background="#80000000">
                <Grid
                    Width="500"
                    Height="400"
                    Background="AntiqueWhite"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"></Grid>
            </Grid>-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition ></RowDefinition>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="应用"></TextBlock>
                        <ItemsControl
                            Margin="0,0,0,30"
                            Grid.Row="1"
                            ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        CornerRadius="8"
                                        Margin="0,5"
                                        Padding="5,10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.BorderBrush>
                                            <SolidColorBrush x:Name="appBC" Color="#a1a1a1"></SolidColorBrush>
                                        </Border.BorderBrush>
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                x:Name="ScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1"></ScaleTransform>
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <ColorAnimation
                                                            Storyboard.TargetName="appBC"
                                                            Storyboard.TargetProperty="Color"
                                                            From="Aqua"
                                                            To="Transparent"
                                                            Duration="0:0:1"></ColorAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="appBC"
                                                                        Storyboard.TargetProperty="Color"
                                                                        To="#a1a1a1"></ColorAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fafafa"></Setter>
                                                <Setter Property="BorderThickness" Value="1"></Setter>
                                                
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#e4e4e4"></Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid
                                            Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"></ColumnDefinition>
                                                <ColumnDefinition></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border 
                                                Width="50"
                                                Height="50"
                                                CornerRadius="8"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="/Assets/Image/hzm_white.png"></ImageBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid
                                                Margin="10,0"
                                                Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    FontSize="20"
                                                    Text="name"></TextBlock>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="information"></TextBlock>
                                            </Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Grid.Column="2"
                                                Text="添加">
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
                
                <Grid
                    Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="运行环境"></TextBlock>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        ClipToBounds="True">
                        <ItemsControl
                            ItemsSource="{Binding AppstorePageMs}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="10"
                                        Padding="4"
                                        CornerRadius="8"
                                        BorderBrush="Aqua"
                                        BorderThickness="0,0,0,1"
                                        Background="#f1f1f1">
                                        <Grid 
                                            ShowGridLines="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition ></RowDefinition>
                                                <RowDefinition ></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"></ColumnDefinition>
                                                <ColumnDefinition ></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Padding="4"
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"></TextBlock>
                                            <TextBlock
                                                Text="Version"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Grid.Column="1"
                                                Grid.Row="0"
                                                ></TextBlock>
                                            <ScrollViewer
                                                Padding="4,12,8,0"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Hidden"
                                                Grid.Row="1"
                                                Grid.Column="1">
                                                <ItemsControl
                                                    AlternationCount="2"
                                                    ItemsSource="{Binding Version}"
                                                    >
                                                    <ItemsControl.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="0"
                                                                        To="1"
                                                                        Duration="0:0:1"></DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ItemsControl.Triggers>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Padding="0,4"
                                                                BorderBrush="#a1a1a1"
                                                                BorderThickness="0,0,0,1">
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform x:Name="translateItem" X="0" Y="0"></TranslateTransform>
                                                                </Border.RenderTransform>
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetName="translateItem"
                                                                                    Storyboard.TargetProperty="X"
                                                                                    To="10"
                                                                                    Duration="0:0:0.2"></DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetName="translateItem"
                                                                                    Storyboard.TargetProperty="X"
                                                                                    To="0"
                                                                                    Duration="0:0:0.2"></DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Effect" Value="{x:Null}"></Setter>
                                                                        <Setter Property="Background" Value=" #e0e0e0"></Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                                                <Setter Property="Background" Value=" #d4d4d4"></Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition></ColumnDefinition>
                                                                        <ColumnDefinition></ColumnDefinition>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Text="{Binding}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"></TextBlock>
                                                                    <Button
                                                                        Content="download"
                                                                        BorderBrush="Transparent"
                                                                        Grid.Column="1"></Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
