<UserControl x:Class="HZMAPP.User_Controls.ItemsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HZMAPP.User_Controls"
             xmlns:vm="clr-namespace:HZMAPP.ViewModels"
             mc:Ignorable="d"
             x:Name="ItemsC">
    
    <UserControl.DataContext>
        <vm:HomePageVM></vm:HomePageVM>
    </UserControl.DataContext>
    <ItemsControl
        x:Name="ItemsCo"
        ItemsSource="{Binding Lis}"
        HorizontalAlignment="Center"
        Grid.Row="1">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Tag="{Binding}"
                        Width="180"
                        Height="220"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Margin="10"
                        CornerRadius="8">
                    <Grid ShowGridLines="True">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border>
                            <Image
                                Width="70"
                                Source="/Assets/Image/hzm_white.png"
                                VerticalAlignment="Center"
                                ></Image>
                        </Border>
                        <Button
                            Grid.Row="0"
                            Content="···"
                            FontSize="20"
                            Width="30"
                            Height="20"
                            Padding="0"
                            Command="{Binding DataContext.ChangeWindowCommand,ElementName=ItemsC}"
                            CommandParameter="{Binding}"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="Transparent"></Setter>
                                            <Setter Property="Foreground" Value="Red"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding}"
                            FontSize="20"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"></TextBlock>
                        <Button
                            Margin="0,10"
                            Foreground="Black"
                            Grid.Row="2"
                            Content="启动"
                            FontWeight="Bold"
                            Command="{Binding DataContext.StartAppCommand,ElementName=ItemsC}"></Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
